// Copied from the guide's templates/. Substitute {worker_name}, {build_dir}
// and {today}.
// Goes at the repo ROOT.
//
// This Worker serves static files. It does not run the framework - the build
// happens in CI and the output directory below is what gets uploaded.
//
// There is ONE Worker. Production is its deployed version; staging and every
// pull request are Worker Previews of this same Worker ("staging",
// "pr-<number>"), which the deploy workflows create with `wrangler preview`.
// A Preview has its own URL and never receives production traffic.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the repo name exactly: lowercase letters, numbers, hyphens,
  // at most 54 characters (Part 2 step 1 explains the limit).
  "name": "portfolio-for-ngoc-anh",

  // {today} = the date you create this file, ISO format, e.g. "2026-08-27".
  // The monthly compat-date-bump workflow keeps it moving from there; Dependabot
  // cannot, because it is a config field rather than a package.
  "compatibility_date": "2026-10-01",

  // Version URLs (one per uploaded version - the production deploy
  // health-checks one BEFORE promoting) and Preview URLs stay on. Only
  // `wrangler deploy` applies this key and the workflows never run it, so it
  // records intent: the live switch is the Worker's own Preview URL setting,
  // which starts on for a Worker created with its workers.dev URL on.
  "preview_urls": true,

  "assets": {
    "directory": "./dist/",

    // Client-routed apps only. Deep links (/dashboard, /invoice/42) must return
    // index.html rather than a 404, and Workers has no `_redirects` file.
    // A multi-page site (Astro content, Next static export with real .html per
    // route) should use "404-page" or omit this key instead.
    "not_found_handling": "single-page-application"
  },

  // Required: `wrangler preview` refuses to run without this block. Empty on
  // purpose - a Preview starts with none of production's variables, secrets or
  // bindings, while `assets` and the compatibility settings above apply to it
  // as they are. Anything a Preview needs of its own goes in here.
  "previews": {}
}
